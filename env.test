# Ambiente usado pelos testes automatizados (banco separado, esvaziado a cada teste).

NODE_ENV=test
PORT=3001

# Pepper das senhas. Valor local de proposito; em producao vem do ambiente, e
# troca-lo invalida todas as senhas cadastradas.
PASSWORD_PEPPER=pepper-local-test-nao-use-em-producao

DB_HOST=localhost
DB_PORT=5432
DB_USER=tasktab
DB_PASSWORD=tasktab
DB_NAME=tasktab_test

# Custo minimo do scrypt: a suite cria e confere senha dezenas de vezes.
PASSWORD_SCRYPT_P=1

DATABASE_URL=postgres://tasktab:tasktab@localhost:5432/tasktab_test

# O commit nao espera o disco: cada um custava ~7 ms de fsync no volume do
# Docker, e a suite faz milhares. Vale so para as conexoes dos testes (o `pg`
# le o PGOPTIONS), e o pior caso, com o Postgres caindo, e perder as ultimas
# transacoes de um banco que e apagado a cada teste.
PGOPTIONS=-c synchronous_commit=off

# Diretorio proprio, esvaziado antes de cada teste junto com o banco. No
# `uploads/` do dev a suite deixava milhares de PDFs, e a contagem de
# referencias de um banco podia apagar o arquivo que o outro ainda usava.
UPLOAD_DIR=uploads-test
