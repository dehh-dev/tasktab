# Ambiente de desenvolvimento local.
# Em producao estas variaveis sao injetadas pelo ambiente (nao existe env.production
# versionado) — o carregador nunca sobrescreve valores ja presentes em process.env.

NODE_ENV=development
PORT=3000

# Pepper das senhas. Valor local de proposito; em producao vem do ambiente, e
# troca-lo invalida todas as senhas cadastradas.
PASSWORD_PEPPER=pepper-local-development-nao-use-em-producao

DB_HOST=localhost
DB_PORT=5432
DB_USER=tasktab
DB_PASSWORD=tasktab
DB_NAME=tasktab_development

# node-pg-migrate le DATABASE_URL
DATABASE_URL=postgres://tasktab:tasktab@localhost:5432/tasktab_development
