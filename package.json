{
  "name": "tasktab",
  "version": "1.0.0",
  "description": "Gerenciador de Tarefas - API REST em arquitetura MVC",
  "main": "src/server.js",
  "engines": {
    "node": ">=24.18.0"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && npm run migrations:up && concurrently -n api,web -c blue,magenta -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch src/server.js",
    "dev:web": "npm run dev -w tasktab-web",
    "build": "npm run build -w tasktab-web",
    "start": "node src/server.js",
    "services:up": "docker compose up -d",
    "services:stop": "docker compose stop",
    "services:down": "docker compose down",
    "services:wait:database": "node scripts/wait-for-postgres.js",
    "migrations:up": "node-pg-migrate --envPath env.development up",
    "migrations:down": "node-pg-migrate --envPath env.development down",
    "migrations:create": "node-pg-migrate create",
    "seed": "npm run services:up && npm run services:wait:database && npm run migrations:up && node seeds/seed.js",
    "pretest": "npm run services:up && cross-env NODE_ENV=test npm run services:wait:database",
    "test": "cross-env NODE_ENV=test concurrently -n api,jest -c blue,magenta --hide api -k -s command-jest \"node src/server.js\" \"jest --runInBand --verbose\"",
    "posttest": "npm run services:stop",
    "pretest:e2e": "npm run services:up && cross-env NODE_ENV=test npm run services:wait:database",
    "test:e2e": "cross-env NODE_ENV=test playwright test",
    "posttest:e2e": "npm run services:stop",
    "test:e2e:ui": "cross-env NODE_ENV=test playwright test --ui",
    "test:watch": "cross-env NODE_ENV=test concurrently -n api,jest -c blue,magenta --hide api -k \"node src/server.js\" \"jest --runInBand --verbose --watchAll\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commit": "cz",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "keywords": [
    "tasks",
    "crud",
    "express",
    "postgres",
    "mvc"
  ],
  "license": "MIT",
  "overrides": {
    "glob": "^11.1.0",
    "minimatch@^3": {
      "brace-expansion": "1.1.16"
    },
    "minimatch@^10": {
      "brace-expansion": "5.0.8"
    }
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.62.1",
    "commitizen": "^4.3.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.9.1",
    "prettier": "^3.4.2"
  }
}
