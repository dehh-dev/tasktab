{
  "name": "tasktab",
  "version": "1.0.0",
  "description": "Gerenciador de Tarefas - API REST em arquitetura MVC",
  "main": "src/server.js",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "migrate": "node-pg-migrate --envPath env.development",
    "migrate:up": "node-pg-migrate --envPath env.development up",
    "migrate:down": "node-pg-migrate --envPath env.development down",
    "migrate:create": "node-pg-migrate create",
    "seed": "node seeds/seed.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --runInBand --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "tasks",
    "crud",
    "express",
    "postgres",
    "mvc"
  ],
  "license": "MIT",
  "overrides": {
    "brace-expansion": "5.0.8",
    "glob": "^11.1.0"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.9.1",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0"
  }
}
